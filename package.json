{
	"name": "@willfatty/plugins",
	"description": "TidaLuna plugins by WillFatty",
	"type": "module",
	"author": "WillFatty",
	"scripts": {
		"watch": "concurrently -r \"pnpm serve\" \"watchexec -e ts,tsx,css -i 'dist/**' -- pnpm build\"",
		"build": "rimraf ./dist && tsx esbuild.config.ts",
		"serve": "http-server ./dist -p 3000 -s --cors -c-1"
	},
	"devDependencies": {
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@inrixia/helpers": "^3.21.0",
		"@mui/icons-material": "^7.3.4",
		"@mui/material": "^7.3.5",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@types/ws": "^8.18.1",
		"concurrently": "^9.1.2",
		"electron": "^37.2.5",
		"http-server": "^14.1.1",
		"luna": "github:Inrixia/TidaLuna",
		"oby": "^15.1.2",
		"rimraf": "^6.1.3",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"ws": "^8.18.3"
	}
}
